  "dependencies": {
    "@paperclip-chat-gateway/core": "workspace:*",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.3"
  }
}
