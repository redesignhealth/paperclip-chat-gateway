{
  "name": "@paperclip-chat-gateway/store-postgres",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
