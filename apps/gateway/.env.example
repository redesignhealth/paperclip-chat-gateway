# Copy to .env for local dev. Never commit a real .env file.

PORT=3000
GATEWAY_CONFIG_PATH=./config/gateway.json
COOKIE_SECRET=change-me-to-a-random-32+-character-secret

# Paperclip API this gateway calls (see docs/paperclip-api.md)
PAPERCLIP_API_BASE_URL=http://127.0.0.1:3100/api

# Generic OIDC provider (any standards-compliant issuer)
OIDC_ISSUER_URL=https://your-issuer.example.com
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
OIDC_ALLOWED_EMAIL_DOMAINS=example.com

# Only set this if the gateway sits behind a reverse proxy you control that
# strips client-supplied X-Forwarded-* headers before setting its own.
# Leave unset to trust no forwarded headers (the safe default). Accepts
# "true", "false", a single IP/CIDR, a comma-separated list, or a hop count.
# TRUST_PROXY=127.0.0.1

# Override the resolved path to the built UI's static assets. Leave unset
# to auto-resolve from the transport-web package (works in both local dev
# and the Docker image layout).
# UI_DIST_PATH=./packages/transport-web/ui/dist

# Per-agent Paperclip API keys. "env" reads PAPERCLIP_AGENT_KEY__<encoded agentId>
# from the process environment, where every non-alphanumeric character in
# agentId (including a literal "_") is escaped to `_XX` (its lowercase hex
# char code) so distinct agentIds can never collide onto the same env var.
# Use EnvAgentCredentialStore.envVarNameFor("your-agent-id") to compute the
# exact name. For "agent-alice-cfo" that's PAPERCLIP_AGENT_KEY__agent_2dalice_2dcfo.
# "file" reads a JSON agentId->key map from CREDENTIAL_STORE_FILE_PATH instead;
# swap for an SSM-backed store later behind the same AgentCredentialStore
# interface (not implemented yet in this v1 scaffold).
CREDENTIAL_STORE_KIND=env
# CREDENTIAL_STORE_FILE_PATH=./config/agent-credentials.json
PAPERCLIP_AGENT_KEY__agent_2dalice_2dcfo=replace-with-a-claimed-per-agent-key

# --- Agent-facing identity broker (POST /api/agent/scheduler) — OPT-IN ---
# The reverse direction: verifies calls FROM Paperclip agents instead of
# from humans. See README "Trust model" before setting any of this up.
# Leaving AGENT_JWT_SECRET unset disables this feature entirely: the
# gateway starts normally and /api/agent/scheduler is not registered.
# Setting it turns the broker on and requires AGENT_JWT_COMPANY_ID and BOTH
# AGENT_JWT_ISSUER and AGENT_JWT_AUDIENCE (validated at startup).

# Must equal Paperclip's own PAPERCLIP_AGENT_JWT_SECRET / BETTER_AUTH_SECRET
# for the Paperclip deployment this gateway brokers for. This is a shared
# symmetric secret: this gateway and Paperclip must run in the same trust
# domain, and the downstream scheduler must NEVER be given this value.
# Never commit a real value; supply it from your deployment's secret store.
# The placeholder below is deliberately short so a copy-paste-without-
# editing deployment fails the .min(32) check instead of silently booting
# with a well-known "secret".
# AGENT_JWT_SECRET=change-me

# REQUIRED whenever AGENT_JWT_SECRET is set. Comma-separated allowlist of
# Paperclip company ids this gateway accepts agent run tokens for. Without
# this, a validly-signed token minted for a different company on the same
# Paperclip control-plane instance would verify successfully here.
# AGENT_JWT_COMPANY_ID=your-company-id

# Paperclip control-plane instanceId whose tokens this gateway accepts.
# Leave unset to accept the live plane's default instanceId ("default").
# AGENT_JWT_INSTANCE_ID=default

# BOTH of these are REQUIRED when the broker is enabled — a two-dimensional
# binding of this trust boundary to an issuer AND an audience, rather than
# signature+company alone. Requiring only one would collapse that
# defense-in-depth to a single claim.
# AGENT_JWT_ISSUER=paperclip
# AGENT_JWT_AUDIENCE=paperclip-api

# Mirrors Paperclip's own legacy-fallback flag. Opt-in only (default
# false/disabled — the fail-closed posture): enable only if you've
# confirmed a pre-per-company-derivation token can still be outstanding for
# your deployment, and only for as long as that's true.
# AGENT_JWT_ENABLE_LEGACY_FALLBACK=false

# Clock-skew tolerance (seconds) applied to exp/nbf checks. Defaults to 5
# when unset.
# AGENT_JWT_CLOCK_TOLERANCE_SECONDS=5

# Optional additional bound on token age (seconds), independent of exp.
# Unset by default (no bound beyond exp).
# AGENT_JWT_MAX_TOKEN_AGE_SECONDS=3600

# Base URL of the downstream scheduler service. Leave unset if you haven't
# wired one up yet — the broker route will respond 501 either way right now
# (HttpSchedulerClient.forward is not implemented yet; see README "Open
# transport question"). Must be https:// and must not point at a
# loopback/link-local/metadata address.
# SCHEDULER_BASE_URL=https://scheduler.example.com

# Dev-only escape hatch: allows http:// and loopback/link-local
# SCHEDULER_BASE_URL values. Never set in production.
# SCHEDULER_ALLOW_INSECURE_URL=false
